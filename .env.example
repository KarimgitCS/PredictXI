# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Postgres (hosted — Neon or Supabase free tier, used for both development and the demo) ---
# Get this from your provider's dashboard: Neon > project > Connection Details,
# or Supabase > project > Settings > Database > Connection string (URI, "Session" mode).
# Both require SSL — keep ?sslmode=require (Neon) or the provider's default query params.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- football-data.org (free tier) ---
# Register at https://www.football-data.org/client/register to get a key.
FOOTBALL_DATA_ORG_API_KEY=
